# Copy to .env  (cp .env.example .env). Read by docker compose, backend/scripts/* and the n8n init.

# ---- Postgres (app DB "loans" + n8n's own DB "n8n" live in one local container) ----
POSTGRES_USER=loans
POSTGRES_PASSWORD=loans_local_pw
DATABASE_URL=postgresql://loans:loans_local_pw@localhost:5433/loans

# ---- Local AWS (moto). On AWS leave AWS_ENDPOINT_URL unset. ----
AWS_ENDPOINT_URL=http://localhost:5000
S3_PUBLIC_ENDPOINT_URL=http://localhost:5000
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
UPLOAD_BUCKET=loan-engine-uploads

# ---- Backend -> n8n Workflow B webhook (signed with WEBHOOK_SECRET) ----
N8N_MATCH_WEBHOOK_URL=http://localhost:5678/webhook/match-users
WEBHOOK_SECRET=change-me-local-secret

# ---- n8n ----
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
# LLM used for (a) crawler extraction and (b) turning free-text criteria into thresholds.
# gemini = hosted free tier (rate-limited) | ollama = local open model, free and unlimited (no key)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# ---- Notifications (Workflow C) ----
# All mail is redirected to aliases of this address: abcd@gmail.com -> abcd+1@gmail.com, abcd+2@gmail.com ...
# (the default below only works with the local Mailpit inbox)
TEST_RECIPIENT=demo@example.test
# Safety valve: send at most this many emails per run (empty = no limit)
NOTIFY_MAX_EMAILS=5
# Must stay false unless you really want to email the addresses in the CSV
NOTIFY_LIVE=false
# smtp = local Mailpit (http://localhost:8025) | ses = AWS SES node
EMAIL_TRANSPORT=smtp
SES_FROM=
# Only needed for EMAIL_TRANSPORT=ses
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
