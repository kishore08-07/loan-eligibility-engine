# Variables read by serverless.yml at deploy time.  cp deploy.env.example deploy.env; edit; then:
#   set -a; . ./deploy.env; set +a; npx serverless deploy --stage dev
# (deploy.env holds secrets: it is git-ignored)

# --- required: network (an existing VPC; `eval "$(bash ../infra/aws_network_env.sh)"` prints these for the default VPC)
VPC_ID=vpc-xxxxxxxx
SUBNET_A_ID=subnet-aaaaaaaa          # two subnets in DIFFERENT availability zones of VPC_ID
SUBNET_B_ID=subnet-bbbbbbbb
ROUTE_TABLE_ID=rtb-xxxxxxxx          # route table those subnets use (gets the free S3 gateway endpoint)

# --- required: secrets / wiring
DB_PASSWORD=                         # openssl rand -hex 16   (no / @ " or spaces)
WEBHOOK_SECRET=                      # openssl rand -hex 32   (same value goes into n8n's .env.aws)
N8N_ENCRYPTION_KEY=                  # openssl rand -hex 32 (protects credentials stored in n8n)

# --- required: email (SES sandbox: sender and recipients must be verified; the stack creates the identities)
SES_SENDER_EMAIL=abcd@gmail.com
TEST_RECIPIENT=abcd@gmail.com        # emails go to abcd+1@gmail.com, abcd+2@..., so verify those below
SES_RECIPIENT_1=abcd+1@gmail.com
SES_RECIPIENT_2=abcd+2@gmail.com
SES_RECIPIENT_3=abcd+3@gmail.com

# --- optional (defaults shown)
GEMINI_API_KEY=                      # needed for Workflow A and free-text criteria (or set LLM_PROVIDER)
NOTIFY_MAX_EMAILS=3
N8N_INSTANCE_TYPE=t3.small
AWS_REGION=us-east-1
CORS_ORIGIN=http://localhost:5173    # origin of the UI; default '*'
ALERT_EMAIL=                         # DLQ alarm email; empty = no subscription
DB_INSTANCE_CLASS=db.t4g.micro
DB_MULTI_AZ=false                    # true for production
DB_ENGINE_VERSION=17
