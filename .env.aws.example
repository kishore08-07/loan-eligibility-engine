# Copy to .env.aws on the EC2 host that runs n8n.  See README "AWS deployment".
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
WEBHOOK_SECRET=same-value-as-the-lambda-WEBHOOK_SECRET
APP_DB_HOST=<DatabaseEndpoint output of serverless deploy>
APP_DB_PASSWORD=<same as DB_PASSWORD used at deploy>
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
MATCH_TOP_K=all
# Emails go to aliases of this address (abcd@gmail.com -> abcd+1@gmail.com, abcd+2@gmail.com ...) unless NOTIFY_LIVE=true
TEST_RECIPIENT=abcd@gmail.com
NOTIFY_MAX_EMAILS=3
NOTIFY_LIVE=false
# SES sender: must be a verified identity (sandbox: the recipient must be verified too)
SES_FROM=abcd@gmail.com
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
N8N_PUBLIC_URL=http://localhost:5678/
